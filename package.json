{
  "name": "mysteryshirtinaboxreviews",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static reviews hub for Mystery Shirt in a Box (mysteryshirtinaboxreviews.com). No dependencies.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:live": "SITE_MODE=live BASE_PATH= node scripts/build.mjs",
    "build:preview": "SITE_MODE=preview BASE_PATH=/mysteryshirtinaboxreviews node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": { "node": ">=20" }
}
